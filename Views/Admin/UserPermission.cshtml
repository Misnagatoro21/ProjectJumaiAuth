@model ProjectJumaiAuth.DTOS.UserPermissionDto
@{
    ViewData["Title"] = $"Permisos de {Model.UserName}";
    var allPermissions = ViewBag.AllPermissions as IReadOnlyList<ProjectJumaiAuth.DTOS.PermissionDto> ?? [];
    var allRoles = ViewBag.AllRoles as IReadOnlyList<ProjectJumaiAuth.DTOS.RoleWithPermissionDto> ?? [];
    var directByPermission = Model.DirectPermission.ToDictionary(p => p.PermissionId);
    var canChangeRole = ViewBag.CanChangeRole as bool??? false;
}

<div class="alert alert-info py-2 mb-4">
    <i class="fa-solid fa-circle-info me-1"></i>
    Los permisos efectivos se leen de la base de datos. El menú también usa la BD, pero las páginas validan el JWT.
    Si no ves <strong>Cursos</strong> o te sale acceso denegado, pulsa <strong>Actualizar sesión</strong> en el menú superior.
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.UserName</h1>
        <p class="text-muted mb-0">@Model.Email · Rol actual: <strong>@Model.RoleName</strong></p>
    </div>
    <a asp-action="Users" class="btn btn-outline-secondary btn-sm">Volver a usuarios</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        @if (canChangeRole)
        {
            <div class="card admin-card">
                <div class="card-header bg-white fw-semibold">Cambiar rol</div>
                <div class="card-body">
                    <div class="input-group">
                        <select id="userRoleSelect" class="form-select">
                            @foreach (var role in allRoles)
                            {
                                <option value="@role.Id" selected="@(role.Id == Model.RoleId)">@role.Name</option>
                            }
                        </select>
                        <button type="button" id="btnUpdateRole" class="btn btn-primary" data-user-id="@Model.UserId">
                            Guardar rol
                        </button>
                    </div>
                    <div class="form-text mt-2">El usuario deberá volver a iniciar sesión o esperar la renovación del JWT para ver los cambios.</div>
                </div>
            </div>
        }
    </div>
    <div class="col-lg-6">
        <div class="card admin-card">
            <div class="card-header bg-white fw-semibold">Permisos efectivos</div>
            <div class="card-body">
                @if (Model.EffectivePermission.Count == 0)
                {
                    <p class="text-muted mb-0">Sin permisos efectivos.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var permission in Model.EffectivePermission)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@permission</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header bg-white fw-semibold">Permisos directos (override)</div>
    <div class="card-body">
        <table id="userPermissionsTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>Permiso</th>
                    <th>Descripción</th>
                    <th>Override</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var permission in allPermissions)
                {
                    directByPermission.TryGetValue(permission.Id, out var direct);
                    <tr data-permission-id="@permission.Id">
                        <td><code>@permission.Name</code></td>
                        <td>@(permission.Description ?? "-")</td>
                        <td>
                            @if (direct == null)
                            {
                                <span class="badge bg-light text-dark border">Heredado del rol</span>
                            }
                            else if (direct.IsGranted)
                            {
                                <span class="badge bg-success">Concedido</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Denegado</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-success btn-user-grant"
                                        data-user-id="@Model.UserId" data-permission-id="@permission.Id">
                                    Conceder
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-user-deny"
                                        data-user-id="@Model.UserId" data-permission-id="@permission.Id">
                                    Denegar
                                </button>
                                @if (direct != null)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-user-remove"
                                            data-user-id="@Model.UserId" data-permission-id="@permission.Id">
                                        Quitar
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/user-permission.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
}