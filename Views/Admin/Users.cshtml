@model IReadOnlyList<ProjectJumaiAuth.DTOS.UserListItemDto>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Usuarios</h1>
        <p class="text-muted mb-0">Gestiona permisos directos y roles por usuario.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver al panel</a>
</div>

<div class="card admin-card">
    <div class="card-header bg-white fw-semibold">Usuarios registrados (@Model.Count)</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td><span class="badge bg-info text-dark">@user.RoleName</span></td>
                        <td class="text-end">
                            <a asp-action="UserPermissions" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                Permisos
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>