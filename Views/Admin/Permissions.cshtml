@using ProyectJumaiAuth.Extenciones
@{
	ViewData["Title"] = "Permisos";

}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Permisos</h1>
        <p class="text-muted mb-0">Crea permisos y se usa en roles y permisos</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.TienePermiso("permiso.crear"))
        {
            <button type="button" class="btn btn-success btn-sm" id="btnNuevoPermiso">
                <i class="fa-solid fa-plus me-1"></i>
                Nuevo Permiso
            </button>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver al panel</a>
    </div>
</div>
<div class="card admin-card">
    <div class="card-body">
        <table id="permissionTable" class="table table-striped table w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Descripcion</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<div class="modal fade" id="permisoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="permisoModalTitle">Permiso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="permisoForm" novalidate>
                <div class="modal-body">

                    <input type="hidden" id="permisoId" />

                    <div class="mb-3">
                        <label class="form-label" for="permisoNombre">Nombre</label>
                        <input type="text"
                               id="permisoNombre"
                               name="permisoNombre"
                               class="form-control"
                               maxlength="100"
                               placeholder="Ej: estudiante.crear" />

                        <div class="form-text">
                            Formato: recurso.accion – ver, crear, actualizar, borrar
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="permisoDescripcion">
                            Descripción
                        </label>
                        <input type="text"
                               id="permisoDescripcion"
                               name="permisoDescripcion"
                               class="form-control"
                               maxlength="250"
                               placeholder="Descripción opcional" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            id="btnGuardarPermiso">
                        Guardar
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Styles {

    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

}

@section Scripts {

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>

    <script>
        window.permisosConfig = {
            canCreate: @((ViewBag.CanCreate as bool? ?? false).ToString().ToLower()),
            canUpdate: @((ViewBag.canUpdate as bool? ?? false).ToString().ToLower()),
            canDelete: @((ViewBag.CanDelete as bool? ?? false).ToString().ToLower())

                };
    </script>

    <script src="~/js/permisos.js" asp-append-version="true"></script>

}