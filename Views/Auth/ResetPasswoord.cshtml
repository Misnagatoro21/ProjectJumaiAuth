@model ProjectJumaiAuth.DTOS.ResetPasswordRequestDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restablecer Contraseña</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body>
    <div class="overlay">
        <div class="popup-container">
            <main>
                <div class="form-container">
                    <div class="form active">
                        <h1>Restablecer contraseña</h1>
                        <p class="subtitle">Ingresa tu nueva contraseña</p>

                        <!-- Formulario que interceptará el JS -->
                        <form id="resetPasswordForm">
                            <!-- Campos ocultos necesarios para el DTO -->
                            <input type="hidden" id="email" value="@Model.Email" />
                            <input type="hidden" id="token" value="@Model.Token" />

                            <div class="input-group">
                                <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
                                <input type="password" id="newPassword" placeholder="Nueva contraseña" required>
                            </div>

                            <div class="input-group">
                                <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
                                <input type="password" id="confirmPassword" placeholder="Confirmar contraseña" required>
                            </div>

                            <button type="submit" class="signup-btn">Confirmar Cambio</button>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/just-validate@4.2.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/reset-password.js"></script>
</body>
</html>